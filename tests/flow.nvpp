#include <nova>

// if / elif / else
n = 5
if (n > 10) {
    pf "grande"
} elif (n > 3) {
    pf "medio"
} else {
    pf "pequeno"
}

// while + continue
i = 0
while (i < 6) {
    i++
    if (i % 2 == 0) {
        continue
    }
    pf "impar: " + i
}

// for + break
for (j = 1; j <= 10; j++) {
    if (j > 3) {
        break
    }
    pf "j=" + j
}

// soma de 1 a 100
total = 0
for (k = 1; k <= 100; k++) {
    total += k
}
pf "total: " + total

// for aninhado com break no laco de dentro
for (a = 1; a <= 3; a++) {
    for (b = 1; b <= 3; b++) {
        if (b > a) {
            break
        }
        pf a + "x" + b + "=" + (a * b)
    }
}

// switch: sem fallthrough
dia = 3
switch (dia) {
case 1:
    pf "segunda"
case 2:
    pf "terca"
case 3:
    pf "quarta"
    break
default:
    pf "outro"
}
dia = 1
switch (dia) {
case 1:
    pf "segunda"
case 2:
    pf "terca"
default:
    pf "outro"
}
dia = 9
switch (dia) {
case 1:
    pf "segunda"
default:
    pf "outro"
}

// condicao com && e variavel do laco
x = 100
steps = 0
while (x != 1 && steps < 1000) {
    if (x % 2 == 0) {
        x /= 2
    } else {
        x = 3 * x + 1
    }
    steps++
}
pf "collatz(100) passos: " + steps

// escopo de bloco: let interno nao mexe no externo
v = 1
if (true) {
    let v = 2
    pf "interno: " + v
}
pf "externo: " + v
